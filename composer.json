{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apirelio/cakephp",
    "description": "Fail-safe CakePHP middleware for Apirelio customer integration analytics.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "api-monitoring",
        "cakephp",
        "customer-analytics",
        "observability"
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "apirelio/php-core": "^0.2",
        "cakephp/cakephp": "^4.5 || ^5.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Apirelio\\CakePHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apirelio\\CakePHP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-core",
            "options": {
                "symlink": true,
                "versions": {
                    "apirelio/php-core": "0.2.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
